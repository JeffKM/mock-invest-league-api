# EC2 의 /opt/league/.env 로 복사해 값을 채운다(chmod 600). 이 파일 자체는 git 에 올라가지만 .env 는 올라가지 않는다.
DB_URL=jdbc:postgresql://<RDS 엔드포인트>:5432/league?sslmode=require
DB_USERNAME=league
DB_PASSWORD=<RDS 마스터 비밀번호>
# openssl rand -hex 32 로 만든 값. /api/admin/** 요청에 X-Admin-Token 헤더로 보낸다
ADMIN_TOKEN=<관리자 토큰>
# 선택
# DB_POOL_SIZE=10
# ACTUATOR_EXPOSE=health,info
